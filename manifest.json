{
  "manifest_version": 3,
  "name": "TubeFolio",
  "version": "4.61.0",
  "description": "YouTubeの登録チャンネルをフォルダで整理。フォルダ別の新着・動画・ライブ・ショート一覧、通知、集中モード、視聴記録。",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "alarms",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://returnyoutubedislikeapi.com/*",
    "https://translate.googleapis.com/*",
    "https://www.youtube-nocookie.com/*",
    "https://sponsor.ajay.app/*",
    "https://api.github.com/*",
    "https://ja.wikipedia.org/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://ipapi.co/*",
    "https://archive.org/*",
    "https://web.archive.org/*"
  ],
  "action": {
    "default_title": "TubeFolio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "mainworld.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared.js",
        "yt-api.js",
        "extras.js",
        "feed.js",
        "manager.js",
        "comments.js",
        "chapters.js",
        "content.js",
        "playerx.js",
        "xtra.js",
        "antitrans.js",
        "speaker.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "embedref",
        "enabled": true,
        "path": "embed_rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pv.html",
        "pv.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    },
    {
      "resources": [
        "sounds/*.mp3"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
